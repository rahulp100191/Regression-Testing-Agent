  "metric_explanations": {
    "recall": {
      "formula": "TP / (TP + FN)",
      "why_it_matters": "Measures missed required coverage. Low recall can leave changed payroll or security behavior untested."
    },
    "precision": {
      "formula": "TP / (TP + FP)",
      "why_it_matters": "Measures useful recommendations. Low precision consumes consultant time on unnecessary tests."
    },
    "false_negatives": {
      "formula": "Count of required golden selections that were not returned",
      "why_it_matters": "Review these first. Each case shows the missed test and whether retrieval or later selection failed."
    },
    "false_positives": {
      "formula": "Count of returned selections outside the accepted golden answer",
      "why_it_matters": "Shows wasted regression effort. A wrong test on a positive case produces both an FP and an FN."
    },
    "exact_match_rate": {
      "formula": "Cases whose complete selected set equals any accepted golden set / evaluated cases",
      "why_it_matters": "Measures full set agreement. Empty matches count, so also inspect positive-case accuracy and the decision confusion matrix."
    },
    "top_k_retrieval_recall": {
      "formula": "Average fraction of an accepted required set present in the actual K-item shortlist, across gold-match cases",
      "why_it_matters": "Separates retrieval problems from LLM problems. The LLM cannot choose a correct test that it never sees."
    },
    "no_match_accuracy": {
      "formula": "Correct no_matching_e2e decisions / gold no_matching_e2e cases",
      "why_it_matters": "Checks catalog-gap recognition. unable_to_identify is a different decision and receives no credit here."
    },
    "hallucination_rate": {
      "formula": "Successful raw responses naming an out-of-catalog test / successful raw responses",
      "why_it_matters": "Measures invention before guardrails remove invalid names. A valid catalog test outside the shortlist is a retrieval/selection violation, not a catalog hallucination."
    },
    "confidence_calibration": {
      "formula": "ECE = sum(bin_count/N * abs(mean_confidence - accuracy)); Brier = mean((confidence - correctness)^2)",
      "why_it_matters": "Checks whether reported certainty matches observed correctness. Both scores are better near zero. The app score is a heuristic, not a calibrated probability."
    }
  }
}
