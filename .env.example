AWS_REGION=ap-southeast-2
LLM_PROVIDER=gemma
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
# Gemma 4: minimal disables thinking; high enables it (slower, needs more output budget).
GEMMA_THINKING_LEVEL=minimal
LLM_MAX_OUTPUT_TOKENS=4096
# Optional fully local model: set LLM_PROVIDER=ollama and install/pull this model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
REVIEW_THRESHOLD=70
FRONTEND_ORIGIN=http://localhost:3000
# PostgreSQL evaluation persistence.
POSTGRES_PASSWORD=replace-with-a-strong-password
# Optional provider pricing; omit to show unknown cost.
# EVAL_INPUT_USD_PER_MILLION=0
# EVAL_OUTPUT_USD_PER_MILLION=0

# Automatic provider fallback (explicit model names are saved in each report).
LLM_FALLBACK_MODELS=ollama/qwen3:0.6b,ollama/qwen2.5:0.5b
LLM_HTTP_ATTEMPTS=1
# Applies to each HTTP attempt; large prompts on a CPU may need a higher timeout.
LLM_TIMEOUT_SECONDS=120
# Self-hosted tracing dashboard. Compose sets the internal exporter address.
JAEGER_PUBLIC_URL=http://127.0.0.1:16686
# Reviewer-only approval/export. Set a strong secret and enter it in the review tab.
FEEDBACK_REVIEWER_KEY=
# Local rules always run. Production should require a configured managed classifier.
SAFETY_REQUIRE_MANAGED=false
SAFETY_MAX_TEXT_CHARS=60000
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
# Multi-row inference, bounded concurrency and input/output budgets.
ANALYSIS_BATCH_SIZE=5
ANALYSIS_BATCH_CONCURRENCY=2
ANALYSIS_BATCH_MAX_CHARS=24000
ANALYSIS_OUTPUT_TOKENS_PER_ROW=1024
